@page
@model EntityFramework.Pages.MascotaPages.DeleteModel

@{
    ViewData["Title"] = "Eliminar Mascota";
}

<div class="container my-4">
    
    <div class="mb-3">
        <a asp-page="./Index" class="btn btn-link text-secondary text-decoration-none p-0">
            ⬅️ Volver al listado
        </a>
    </div>

   
    <div class="card shadow-sm border-0 rounded">
        <div class="card-header bg-danger text-white py-3">
            <h3 class="card-title m-0 h5 fw-bold">⚠️ Confirmar Eliminación</h3>
            <small class="text-white-50">Esta acción no se puede deshacer de ninguna manera.</small>
        </div>

        <div class="card-body p-4">
           
            <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                <span class="fs-4 me-2">🚨</span>
                <div>
                    <strong>¿Estás completamente seguro de que deseas eliminar este registro?</strong> Toda la información asociada a esta mascota se borrará permanentemente.
                </div>
            </div>

            <div class="row g-3 bg-light rounded p-3 border mb-4">
                <div class="col-12 border-bottom pb-2 mb-2">
                    <h5 class="text-secondary m-0 h6 text-uppercase fw-bold">Datos de la mascota a eliminar</h5>
                </div>

                <div class="col-md-6 col-lg-4">
                    <span class="text-muted d-block small fw-bold">@Html.DisplayNameFor(model => model.Mascota.Nombre)</span>
                    <span class="text-dark fw-bold fs-5">@Html.DisplayFor(model => model.Mascota.Nombre)</span>
                </div>

                <div class="col-md-6 col-lg-4">
                    <span class="text-muted d-block small fw-bold">@Html.DisplayNameFor(model => model.Mascota.Especie)</span>
                    <span class="badge bg-secondary mt-1">@Html.DisplayFor(model => model.Mascota.Especie)</span>
                </div>

                <div class="col-md-6 col-lg-4">
                    <span class="text-muted d-block small fw-bold">@Html.DisplayNameFor(model => model.Mascota.Raza)</span>
                    <span class="text-dark fw-semibold">@Html.DisplayFor(model => model.Mascota.Raza)</span>
                </div>

                <div class="col-md-4 col-sm-6">
                    <span class="text-muted d-block small fw-bold">@Html.DisplayNameFor(model => model.Mascota.Edad)</span>
                    <span class="text-dark">@Html.DisplayFor(model => model.Mascota.Edad) años</span>
                </div>

                <div class="col-md-4 col-sm-6">
                    <span class="text-muted d-block small fw-bold">@Html.DisplayNameFor(model => model.Mascota.Peso)</span>
                    <span class="text-dark">@Html.DisplayFor(model => model.Mascota.Peso) kg</span>
                </div>

                <div class="col-md-4 col-sm-12">
                    <span class="text-muted d-block small fw-bold">@Html.DisplayNameFor(model => model.Mascota.EsDomestica)</span>
                    @if (Model.Mascota.EsDomestica)
                    {
                        <span class="text-success fw-bold">🏠 Doméstica</span>
                    }
                    else
                    {
                        <span class="text-warning fw-bold">🌳 No doméstica</span>
                    }
                </div>
            </div>

           
            <form method="post">
                <input type="hidden" asp-for="Mascota.Id" />

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">Cancelar, mantener registro</a>
                    <button type="submit" class="btn btn-danger px-4 shadow-sm fw-bold">🗑️ Sí, Eliminar Definitivamente</button>
                </div>
            </form>
        </div>
    </div>
</div>
