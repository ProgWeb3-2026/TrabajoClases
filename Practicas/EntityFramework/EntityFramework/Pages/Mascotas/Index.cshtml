@page
@model EntityFramework.Pages.MascotaPages.IndexModel

@{
    ViewData["Title"] = "Mascotas";
}

<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="fw-bold text-dark mb-1">Gestión de Mascotas</h1>
            <p class="text-muted mb-0">Listado general de mascotas registradas en el sistema.</p>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill">
                <i class="bi bi-plus-circle me-1"></i> Nueva Mascota
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase fs-7 text-secondary tracking-wider">
                        <tr>
                            <th class="py-3 px-4">@Html.DisplayNameFor(model => model.Mascota[0].Nombre)</th>
                            <th class="py-3 px-3">@Html.DisplayNameFor(model => model.Mascota[0].Especie)</th>
                            <th class="py-3 px-3">@Html.DisplayNameFor(model => model.Mascota[0].Raza)</th>
                            <th class="py-3 px-3">@Html.DisplayNameFor(model => model.Mascota[0].Edad)</th>
                            <th class="py-3 px-3">@Html.DisplayNameFor(model => model.Mascota[0].Peso)</th>
                            <th class="py-3 px-3">@Html.DisplayNameFor(model => model.Mascota[0].EsDomestica)</th>
                            <th class="py-3 px-4 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Mascota)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold text-dark">@Html.DisplayFor(model => item.Nombre)</div>
                                </td>
                                <td class="px-3 py-3 text-secondary">@Html.DisplayFor(model => item.Especie)</td>
                                <td class="px-3 py-3 text-secondary">@Html.DisplayFor(model => item.Raza)</td>
                                <td class="px-3 py-3 text-secondary">@Html.DisplayFor(model => item.Edad) años</td>
                                <td class="px-3 py-3 text-secondary">@Html.DisplayFor(model => item.Peso) kg</td>
                                <td class="px-3 py-3">
                                    @if (item.EsDomestica)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">Doméstica</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-pill">Silvestre</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm text-primary border" title="Editar">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-info border" title="Detalles">
                                            <i class="bi bi-eye"></i> Detalles
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm text-danger border" title="Eliminar">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>