@page
@model EntityFramework.Pages.MascotaPages.EditModel

@{
    ViewData["Title"] = "Editar Mascota";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h2 class="fw-bold text-dark mb-1">Editar Mascota</h2>
                            <p class="text-muted small mb-0">Modifica los campos necesarios para actualizar la información.</p>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                            <i class="bi bi-pencil-square fs-4"></i>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 py-2 small" role="alert"></div>
                        <input type="hidden" asp-for="Mascota.Id" />

                        <div class="form-floating mb-3">
                            <input asp-for="Mascota.Nombre" class="form-control rounded-3" placeholder="Nombre" aria-required="true" />
                            <label asp-for="Mascota.Nombre" class="text-muted"><span class="text-danger">*</span> Nombre</label>
                            <span asp-validation-for="Mascota.Nombre" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Mascota.Especie" class="form-control rounded-3" placeholder="Especie" />
                            <label asp-for="Mascota.Especie" class="text-muted">Especie</label>
                            <span asp-validation-for="Mascota.Especie" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Mascota.Raza" class="form-control rounded-3" placeholder="Raza" aria-required="true" />
                            <label asp-for="Mascota.Raza" class="text-muted"><span class="text-danger">*</span> Raza</label>
                            <span asp-validation-for="Mascota.Raza" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Mascota.Edad" class="form-control rounded-3" placeholder="Edad" />
                                    <label asp-for="Mascota.Edad" class="text-muted">Edad</label>
                                    <span asp-validation-for="Mascota.Edad" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Mascota.Peso" class="form-control rounded-3" placeholder="Peso" />
                                    <label asp-for="Mascota.Peso" class="text-muted">Peso (kg)</label>
                                    <span asp-validation-for="Mascota.Peso" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-check form-switch bg-light p-3 rounded-3 mb-4 d-flex align-items-center justify-content-between">
                            <label asp-for="Mascota.EsDomestica" class="form-check-label fw-semibold text-secondary mb-0 cursor-pointer">
                                <span class="text-danger">*</span> ¿Es doméstica?
                            </label>
                            <input asp-for="Mascota.EsDomestica" class="form-check-input fs-5 ms-2" role="switch" aria-required="true" />
                            <span asp-validation-for="Mascota.EsDomestica" class="text-danger small d-block"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 rounded-pill shadow-sm fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> Guardar Cambios
                            </button>
                            <a asp-page="./Index" class="btn btn-light py-2 rounded-pill text-secondary border mt-1">
                                <i class="bi bi-arrow-left me-1"></i> Volver a la lista
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}