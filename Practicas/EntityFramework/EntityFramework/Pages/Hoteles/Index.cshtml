@page
@model EntityFramework.Pages.HotelPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Hotel[0].Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hotel[0].Cuidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hotel[0].CategoriaEstrellas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hotel[0].PrecioPorNoche)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Hotel[0].Disponible)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Hotel) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Cuidad)
            </td>
            <td>
                @Html.DisplayFor(model => item.CategoriaEstrellas)
            </td>
            <td>
                @Html.DisplayFor(model => item.PrecioPorNoche)
            </td>
            <td>
                @Html.DisplayFor(model => item.Disponible)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
