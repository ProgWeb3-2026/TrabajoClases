@model IEnumerable<MVCinicial.Models.Empleado>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sueldo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CorreoElectronico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaNacimiento)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Apellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sueldo)
            </td>
            <td>
                @Html.DisplayFor(model => item.CorreoElectronico)
            </td>
            <td>
                @Html.DisplayFor(model => item.Password)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaNacimiento)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdEmpleau">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdEmpleau">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdEmpleau">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
