@page
@model Clase04_Demo.Pages.Demos.SinLayoutModel
@{
    // Layout = null cancela el layout para esta página.
    // _ViewStart.cshtml asignó Layout = "_Layout", pero aquí lo anulamos.
    // Esta página se renderiza como HTML puro, sin navbar ni footer.
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Página Sin Layout</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
</head>
<body class="p-4">
    <div class="alert alert-warning">
        <h4>⚠️ Esta página usa <code>Layout = null</code></h4>
        <p>No tiene navbar, ni footer, ni el shell HTML del layout compartido.</p>
        <p>Cada página es responsable de su propio <code>&lt;!DOCTYPE&gt;</code> y estructura HTML completa.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>¿Cuándo usar <code>Layout = null</code>?</h5>
            <ul>
                <li>Páginas de login / registro con diseño completamente diferente</li>
                <li>Páginas de error personalizadas</li>
                <li>Respuestas parciales para AJAX (solo un fragmento HTML)</li>
                <li>Páginas de impresión</li>
                <li>Landing pages con diseño completamente custom</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h6>Cómo funciona:</h6>
            <pre class="bg-light p-3 rounded small">
@@page
@@model MiApp.Pages.LoginModel
@@{
    // Anula el layout definido en _ViewStart.cshtml
    Layout = null;
}
&lt;!DOCTYPE html&gt;
&lt;html&gt;
  &lt;!-- HTML completo propio de esta página --&gt;
&lt;/html&gt;
</pre>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/Index" class="btn btn-outline-primary">← Volver al inicio (con layout)</a>
    </div>
</body>
</html>
