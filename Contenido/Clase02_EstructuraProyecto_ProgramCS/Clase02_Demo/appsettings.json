{
  //   NOTA: JSON estándar NO permite comentarios, pero appsettings.json SÍ
  //   permite comentarios con // en ASP.NET Core (usando JsonCommentHandling).
  //
  // ▶ MOSTRAR: Las secciones son jerárquicas. Se acceden con "Seccion:Clave":
  //   builder.Configuration["Logging:LogLevel:Default"] → "Information"
  //   builder.Configuration["AppInfo:Nombre"]           → "PRW3 Clase 2 Demo"

  // ─── SECCIÓN 1: Configuración de Logging (por defecto en todos los proyectos) ───
  "Logging": {
    // ▶ MOSTRAR: LogLevel controla qué mensajes se registran.
    //   Niveles (de menos a más severo): Trace < Debug < Information < Warning < Error < Critical
    "LogLevel": {
      "Default": "Information",       // ← Nivel general de la app
      "Microsoft.AspNetCore": "Warning" // ← ASP.NET Core solo muestra Warning y más graves
    }
  },

  // ─── SECCIÓN 2: URLs permitidas para el servidor ───
  "AllowedHosts": "*",
  // ▶ MOSTRAR: "*" permite peticiones de cualquier host.
  //   En producción se restringe a dominios específicos: "miempresa.com;www.miempresa.com"

  // ─── SECCIÓN 3: Cadenas de conexión a base de datos ───
  // ▶ MOSTRAR: Las connection strings se ponen aquí. En Unidad 2 y 3 usaremos EF Core.
  //   NUNCA hardcodear contraseñas en este archivo si va a un repositorio Git público.
  "ConnectionStrings": {
    "Default": "Data Source=clase02demo.db"
    // Para SQL Server sería: "Server=localhost;Database=Clase02DB;Trusted_Connection=True;"
  },

  // ─── SECCIÓN 4: Configuración PERSONALIZADA de la aplicación ───
  // ▶ MOSTRAR: Podemos agregar CUALQUIER sección personalizada.
  //   Se accede con: builder.Configuration["AppInfo:Nombre"]
  //   O con el patrón Options: services.Configure<AppInfo>(config.GetSection("AppInfo"))
  "AppInfo": {
    "Nombre": "PRW3 — Clase 2 Demo",
    "Version": "1.0.0",
    "Autor": "Ing. Victor Ortega Lijeron",
    "Institucion": "Universidad Privada del Valle",
    "Gestion": "2026",
    "Descripcion": "Proyecto demostrativo de estructura de proyecto ASP.NET Core y Program.cs"
  },

  // ─── SECCIÓN 5: Configuración de características de la app ───
  // ▶ MOSTRAR: Feature flags — activan/desactivan características sin re-desplegar.
  "Features": {
    "MostrarInformacionDebug": true,
    "MostrarConfiguracion": true,
    "MostrarPipelineMiddleware": true
  }
}
