{
  // ▶ MOSTRAR: Este archivo SOBREESCRIBE valores de appsettings.json
  //   cuando ASPNETCORE_ENVIRONMENT = "Development" (valor por defecto al presionar F5).
  //
  //   JERARQUÍA de configuración (mayor prioridad gana):
  //   1. Variables de entorno
  //   2. User Secrets (dotnet user-secrets)
  //   3. appsettings.Development.json  ← este archivo
  //   4. appsettings.json
  //
  //   DEMO: Cambiar MostrarInformacionDebug a false aquí y ver que la página cambia.

  "Logging": {
    "LogLevel": {
      // En Development vemos más detalles: nivel Debug
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  // ▶ MOSTRAR: Sobreescribimos solo los valores que cambian por entorno.
  //   Los valores no listados aquí mantienen los de appsettings.json.
  "AppInfo": {
    "Nombre": "PRW3 — Clase 2 Demo [DESARROLLO]",
    "Version": "1.0.0-dev"
  },

  "Features": {
    "MostrarInformacionDebug": true,
    "MostrarConfiguracion": true,
    "MostrarPipelineMiddleware": true
  }
}
