@* ╔══════════════════════════════════════════════════════════════════════════╗ *@
@* ║  PROGRAMACIÓN WEB III — Clase 2                                         ║ *@
@* ║  _Layout.cshtml — Plantilla HTML compartida                            ║ *@
@* ╚══════════════════════════════════════════════════════════════════════════╝ *@

@* ▶ MOSTRAR: _Layout.cshtml define el "esqueleto" HTML que TODAS las páginas comparten.
   Cada página individual se inyecta en @RenderBody().
   Las páginas pueden inyectar contenido adicional en secciones con @RenderSection. *@

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* ▶ MOSTRAR: @ViewData["Title"] es el título que cada página define individualmente.
       En Index.cshtml: ViewData["Title"] = "Clase 2 — ..."; *@
    <title>@ViewData["Title"] | PRW3</title>

    @* Bootstrap 5 CDN *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    @* Estilos propios — servidos desde wwwroot/css/site.css *@
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    @* ▶ MOSTRAR: Navbar con navegación entre páginas *@
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1B3A6B;">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-code-slash"></i> PRW3 — Clase 2
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    @* ▶ MOSTRAR: asp-page es un Tag Helper que genera la URL correcta
                       para la página indicada. Es tipado y seguro. *@
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <i class="bi bi-house"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Configuracion">
                            <i class="bi bi-gear"></i> Configuración
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/PipelineDemo">
                            <i class="bi bi-diagram-3"></i> Pipeline
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <span class="nav-link text-light opacity-75">
                            <i class="bi bi-clock"></i>
                            <span id="reloj-cliente"></span>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @* ▶ MOSTRAR: @RenderBody() — aquí se inyecta el contenido de cada página.
       Sin esta línea, ninguna página mostraría su contenido. *@
    <main role="main">
        @RenderBody()
    </main>

    @* Footer *@
    <footer class="footer mt-5 py-3 border-top">
        <div class="container text-center text-muted small">
            <p class="mb-0">
                Programación Web III — Ing. Victor Ortega Lijeron |
                Universidad Privada del Valle | Gestión 2026
            </p>
            <p class="mb-0">ASP.NET Core @System.Environment.Version.ToString() — .NET 10</p>
        </div>
    </footer>

    @* Bootstrap JS *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @* ▶ MOSTRAR: @RenderSection permite que las páginas inyecten scripts adicionales.
       required: false → no todas las páginas necesitan tener esta sección.
       En Index.cshtml: @section Scripts { <script>...</script> } *@
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
