@page
@model Clase03_Demo.Pages.IndexModel
@{
    ViewData["Title"] = "Clase 3 — Razor Pages";
}

<div class="hero-section">
    <div class="container">
        <span class="badge-tema">Tema 1.3 — Razor Pages: Introducción</span>
        <h1 class="display-5 fw-bold mt-2">¿Qué son Razor Pages?</h1>
        <p class="lead opacity-90">
            Modelo de programación web orientado a páginas de ASP.NET Core.
            Cada página = un archivo <code>.cshtml</code> + un archivo <code>.cshtml.cs</code>.
        </p>
    </div>
</div>

<div class="container mt-4">

    @* Resumen del sistema de archivos de la demo *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-4 fw-bold text-primary">@Model.TotalProductos</div>
                    <div class="text-muted">Productos en catálogo</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-4 fw-bold text-success">@Model.ProductosDisponibles</div>
                    <div class="text-muted">Disponibles</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <div class="display-4 fw-bold text-info">@Model.Categorias.Count</div>
                    <div class="text-muted">Categorías</div>
                </div>
            </div>
        </div>
    </div>

    @* Diagrama Razor Pages: .cshtml + .cshtml.cs *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Estructura de una Razor Page</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <div class="code-file mb-2">
                        <span class="badge bg-warning text-dark me-2">.cshtml</span>
                        <strong>Index.cshtml</strong> — Vista
                        <pre class="mt-2 small bg-light p-2 rounded">@@page
@@model IndexModel

&lt;h1&gt;Hola, @@Model.Nombre&lt;/h1&gt;
@@if (Model.Activo) {
    &lt;p&gt;Activo&lt;/p&gt;
}</pre>
                    </div>
                </div>
                <div class="col-md-2 text-center fs-2 text-muted">⇄</div>
                <div class="col-md-5">
                    <div class="code-file">
                        <span class="badge bg-info text-dark me-2">.cshtml.cs</span>
                        <strong>Index.cshtml.cs</strong> — PageModel
                        <pre class="mt-2 small bg-light p-2 rounded">public class IndexModel : PageModel
{
    public string Nombre { get; set; }
    public bool Activo { get; set; }

    public void OnGet()
    {
        Nombre = "Estudiante";
        Activo = true;
    }
}</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Diferencias con MVC *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header" style="background:#1B3A6B; color:white">
            <h5 class="mb-0">Razor Pages vs MVC — ¿Cuándo usar cada uno?</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Aspecto</th>
                        <th>Razor Pages</th>
                        <th>MVC</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Organización</td>
                        <td>Por página (carpetas bajo /Pages/)</td>
                        <td>Por función: Controllers/ + Views/</td>
                    </tr>
                    <tr>
                        <td>Lógica</td>
                        <td>En el PageModel (.cshtml.cs)</td>
                        <td>En el Controller</td>
                    </tr>
                    <tr>
                        <td>Ideal para</td>
                        <td>CRUD simples, formularios, paneles admin</td>
                        <td>Apps grandes, APIs, lógica compleja</td>
                    </tr>
                    <tr>
                        <td>Curva de aprendizaje</td>
                        <td class="text-success">Más simple para principiantes</td>
                        <td>Mayor separación de responsabilidades</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* Navegación a las demos de la clase *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Páginas Demo de Esta Clase</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <a asp-page="/SintaxisRazor" class="card text-decoration-none h-100 card-hover">
                        <div class="card-body text-center">
                            <div class="fs-1">✍️</div>
                            <h6 class="mt-2">Sintaxis Razor</h6>
                            <small class="text-muted">@@, @@if, @@foreach, bloques C#</small>
                        </div>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-page="/Productos/Index" class="card text-decoration-none h-100 card-hover">
                        <div class="card-body text-center">
                            <div class="fs-1">📦</div>
                            <h6 class="mt-2">Catálogo (OnGet + lista)</h6>
                            <small class="text-muted">PageModel, @@foreach, @@if</small>
                        </div>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-page="/Productos/Detalle" asp-route-id="1" class="card text-decoration-none h-100 card-hover">
                        <div class="card-body text-center">
                            <div class="fs-1">🔗</div>
                            <h6 class="mt-2">Routing con Parámetros</h6>
                            <small class="text-muted">@@page "{id}", asp-route-*</small>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
