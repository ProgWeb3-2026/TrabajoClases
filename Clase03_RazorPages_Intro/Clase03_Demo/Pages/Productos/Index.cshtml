@page
@model Clase03_Demo.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Catálogo de Productos";
    var hayResultados = Model.Productos.Any();
}

<div class="hero-section">
    <div class="container">
        <span class="badge-tema">Tema 1.3.3 — Routing por convención de carpetas</span>
        <h1 class="display-5 fw-bold mt-2">Catálogo de Productos</h1>
        @* Ruta de este archivo: Pages/Productos/Index.cshtml → URL: /Productos *@
        <p class="lead opacity-90">
            Este archivo está en <code>Pages/Productos/Index.cshtml</code> → URL: <code>/Productos</code>
        </p>
    </div>
</div>

<div class="container mt-4">

    @* Explicación del routing de esta página *@
    <div class="alert alert-info mb-4">
        <strong>Routing por convención:</strong>
        La carpeta <code>/Pages/Productos/</code> genera la ruta base <code>/Productos</code>.
        El archivo <code>Index.cshtml</code> dentro de esa carpeta mapea a <code>/Productos</code>
        (el nombre "Index" se omite). Otros archivos en esa carpeta mapean a <code>/Productos/NombreArchivo</code>.
    </div>

    @* Filtro por categoría — demuestra [BindProperty(SupportsGet=true)] *@
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <p class="mb-2 small text-muted">
                Filtro usando <code>[BindProperty(SupportsGet = true)]</code> en el PageModel.
                Al enviar, la URL cambia a <code>/Productos?CategoriaFiltro=...</code>
            </p>
            <form method="get" class="d-flex gap-2">
                <select name="CategoriaFiltro" class="form-select" style="max-width:250px">
                    <option value="">— Todas las categorías —</option>
                    @foreach (var cat in Model.Categorias)
                    {
                        if (cat == Model.CategoriaFiltro)
                        {
                            <option value="@cat" selected>@cat</option>
                        }
                        else
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
                <button type="submit" class="btn btn-primary">Filtrar</button>
                @if (!string.IsNullOrEmpty(Model.CategoriaFiltro))
                {
                    <a asp-page="/Productos/Index" class="btn btn-outline-secondary">Limpiar</a>
                }
            </form>
        </div>
    </div>

    @* Lista de productos *@
    @if (!hayResultados)
    {
        <div class="alert alert-warning">
            No hay productos en la categoría <strong>@Model.CategoriaFiltro</strong>.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var producto in Model.Productos)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm @(producto.Disponible ? "" : "opacity-75")">
                        <div class="card-body">
                            @* Badge de disponibilidad — @if dentro de @foreach *@
                            @if (producto.Disponible)
                            {
                                <span class="badge bg-success float-end">✅ Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary float-end">Sin stock</span>
                            }

                            <span class="badge bg-light text-dark mb-2">@producto.Categoria</span>
                            <h6 class="card-title">@producto.Nombre</h6>
                            <p class="card-text text-muted small">@producto.Descripcion</p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="fs-5 fw-bold text-primary">
                                    @producto.Precio.ToString("C", new System.Globalization.CultureInfo("es-BO"))
                                </span>
                                <small class="text-muted">Stock: @producto.Stock</small>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            @* asp-route-id genera la URL: /Productos/Detalle/1 *@
                            <a asp-page="/Productos/Detalle"
                               asp-route-id="@producto.Id"
                               class="btn btn-sm btn-outline-primary w-100">
                                Ver detalle →
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p class="text-muted small mt-3">
            Mostrando @Model.Productos.Count producto(s)
            @if (!string.IsNullOrEmpty(Model.CategoriaFiltro))
            {
                <span>en la categoría <strong>@Model.CategoriaFiltro</strong></span>
            }
        </p>
    }

</div>
