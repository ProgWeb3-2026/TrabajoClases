@page
@model Clase03_Demo.Pages.SintaxisRazorModel
@{
    ViewData["Title"] = "Sintaxis Razor";

    // Bloque de código C# — @{ } ejecuta código sin producir salida HTML.
    // Úsalo para declarar variables locales o configurar la vista.
    var esImpar = Model.Numero % 2 != 0;
    var colorNumero = esImpar ? "text-warning" : "text-success";
}

<div class="hero-section">
    <div class="container">
        <span class="badge-tema">Tema 1.3.2 — Sintaxis Razor</span>
        <h1 class="display-5 fw-bold mt-2">Sintaxis Razor</h1>
        <p class="lead opacity-90">Mezcla de HTML con C# usando el prefijo <code>@@</code></p>
    </div>
</div>

<div class="container mt-4">

    @* ─── 1. EXPRESIONES RAZOR (@variable) ─────────────────────────────── *@
    <div class="demo-card mb-4">
        <div class="demo-header">1. Expresiones: <code>@@variable</code> y <code>@@(expresión)</code></div>
        <div class="demo-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Código Razor:</strong></p>
                    <pre>@@Model.Saludo
@@Model.FechaHoy
@@(Model.Numero * 2)
@@(Model.EsActivo ? "Sí" : "No")</pre>
                </div>
                <div class="col-md-6">
                    <p><strong>Resultado:</strong></p>
                    <ul class="list-unstyled">
                        <li>Saludo: <strong>@Model.Saludo</strong></li>
                        <li>Fecha: <strong>@Model.FechaHoy.ToString("dd/MM/yyyy HH:mm")</strong></li>
                        <li>Número × 2: <strong class="@colorNumero">@(Model.Numero * 2)</strong></li>
                        <li>¿Activo?: <strong>@(Model.EsActivo ? "Sí" : "No")</strong></li>
                    </ul>
                </div>
            </div>
            <div class="alert alert-info mt-2 mb-0 small">
                <strong>Nota:</strong> Razor escapa el HTML automáticamente — protege contra XSS.
                Para HTML sin escapar (solo datos confiables): <code>@@Html.Raw()</code>
            </div>
        </div>
    </div>

    @* ─── 2. @if / @else ──────────────────────────────────────────────── *@
    <div class="demo-card mb-4">
        <div class="demo-header">2. Condicional: <code>@@if / @@else if / @@else</code></div>
        <div class="demo-body">
            <div class="row">
                <div class="col-md-6">
                    <pre>@@if (Model.EsActivo)
{
    &lt;span class="badge bg-success"&gt;
        Activo
    &lt;/span&gt;
}
else
{
    &lt;span class="badge bg-danger"&gt;
        Inactivo
    &lt;/span&gt;
}</pre>
                </div>
                <div class="col-md-6 d-flex align-items-center">
                    <div>
                        <p>Resultado para <code>Model.EsActivo = @Model.EsActivo</code>:</p>
                        @if (Model.EsActivo)
                        {
                            <span class="badge bg-success fs-6">✅ Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">❌ Inactivo</span>
                        }
                        <p class="mt-3">El número @Model.Numero es:</p>
                        @if (esImpar)
                        {
                            <span class="badge bg-warning text-dark fs-6">Impar</span>
                        }
                        else
                        {
                            <span class="badge bg-success fs-6">Par</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ─── 3. @foreach ─────────────────────────────────────────────────── *@
    <div class="demo-card mb-4">
        <div class="demo-header">3. Bucle: <code>@@foreach</code></div>
        <div class="demo-body">
            <div class="row">
                <div class="col-md-6">
                    <pre>@@foreach (var lenguaje in Model.Lenguajes)
{
    &lt;span class="badge bg-primary m-1"&gt;
        @@lenguaje
    &lt;/span&gt;
}</pre>
                </div>
                <div class="col-md-6 d-flex align-items-center flex-wrap gap-1">
                    @foreach (var lenguaje in Model.Lenguajes)
                    {
                        <span class="badge bg-primary fs-6">@lenguaje</span>
                    }
                </div>
            </div>

            <hr>

            @* foreach con índice usando for *@
            <p><strong>Tabla con <code>@@for</code> e índice:</strong></p>
            <table class="table table-sm table-bordered">
                <thead class="table-dark">
                    <tr><th>#</th><th>Estudiante</th><th>Nota</th><th>Aprobado</th></tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var nota in Model.Notas)
                    {
                        // Variable local dentro del foreach para lógica condicional
                        var aprobado = nota.Value >= 75;
                        <tr class="@(aprobado ? "" : "table-danger")">
                            <td>@(i++)</td>
                            <td>@nota.Key</td>
                            <td><strong>@nota.Value</strong></td>
                            <td>@(aprobado ? "✅ Sí" : "❌ No")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ─── 4. Bloque de código @{ } ────────────────────────────────────── *@
    <div class="demo-card mb-4">
        <div class="demo-header">4. Bloque de código: <code>@@{ }</code></div>
        <div class="demo-body">
            <div class="row">
                <div class="col-md-6">
                    <pre>@@{
    var total = Model.Notas.Values.Sum();
    var promedio = (double)total / Model.Notas.Count;
    var mejor = Model.Notas
        .OrderByDescending(n => n.Value).First();
}</pre>
                </div>
                <div class="col-md-6">
                    @{
                        var total = Model.Notas.Values.Sum();
                        var promedio = (double)total / Model.Notas.Count;
                        // OrderByDescending + First evita el retorno nullable de MaxBy
                        var mejor = Model.Notas.OrderByDescending(n => n.Value).First();
                    }
                    <ul>
                        <li>Total de puntos: <strong>@total</strong></li>
                        <li>Promedio: <strong>@promedio.ToString("F1")</strong></li>
                        <li>Mejor nota: <strong>@mejor.Key — @mejor.Value pts</strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* ─── 5. Formulario GET con [BindProperty(SupportsGet=true)] ──────── *@
    <div class="demo-card mb-4">
        <div class="demo-header">5. Formulario GET y <code>[BindProperty(SupportsGet = true)]</code></div>
        <div class="demo-body">
            <p>
                La propiedad <code>NombreIngresado</code> está marcada con
                <code>[BindProperty(SupportsGet = true)]</code> en el PageModel.
                Al enviar el formulario, la URL cambia a
                <code>/SintaxisRazor?NombreIngresado=TuNombre</code>
                y el PageModel la recibe automáticamente.
            </p>
            <form method="get" class="d-flex gap-2 mb-3">
                <input name="NombreIngresado"
                       value="@Model.NombreIngresado"
                       class="form-control"
                       placeholder="Escribe tu nombre..." />
                <button type="submit" class="btn btn-primary">Saludar</button>
            </form>
            @if (!string.IsNullOrEmpty(Model.NombreIngresado))
            {
                <div class="alert alert-success">
                    ¡Hola, <strong>@Model.NombreIngresado</strong>! Bienvenido a Razor Pages.
                </div>
            }
        </div>
    </div>

    @* ─── 6. Directivas Razor importantes ─────────────────────────────── *@
    <div class="demo-card mb-4">
        <div class="demo-header">6. Directivas Razor — Resumen</div>
        <div class="demo-body">
            <table class="table table-sm table-bordered font-monospace">
                <thead class="table-dark">
                    <tr><th>Directiva</th><th>Propósito</th><th>Obligatoria en Razor Pages</th></tr>
                </thead>
                <tbody>
                    <tr><td>@@page</td><td>Convierte el archivo en una página enrutable</td><td class="text-success fw-bold">Sí</td></tr>
                    <tr><td>@@model Tipo</td><td>Declara el tipo del PageModel. Habilita @@Model.</td><td>Recomendada</td></tr>
                    <tr><td>@@{ }</td><td>Bloque de código C# sin salida</td><td>No</td></tr>
                    <tr><td>@@* comentario *@@</td><td>Comentario que no se envía al cliente</td><td>No</td></tr>
                    <tr><td>@@using Namespace</td><td>Importa un namespace en la vista</td><td>No (mejor en _ViewImports)</td></tr>
                    <tr><td>@@inject IServicio s</td><td>Inyecta un servicio directamente en la vista</td><td>No</td></tr>
                    <tr><td>@@section Nombre { }</td><td>Inyecta contenido en una sección del Layout</td><td>No</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // Resaltar el elemento activo en el nav al cargar la página
        document.querySelectorAll('.nav-link').forEach(link => {
            if (link.href === window.location.href.split('?')[0]) {
                link.classList.add('active');
            }
        });
    </script>
}
