@page
@model Examen.Pages.TareaPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Tarea</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tarea.Titulo" class="control-label"></label>
                <input asp-for="Tarea.Titulo" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tarea.Titulo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tarea.Descripcion" class="control-label"></label>
                <input asp-for="Tarea.Descripcion" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tarea.Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tarea.FechaVencimiento" class="control-label"></label>
                <input asp-for="Tarea.FechaVencimiento" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tarea.FechaVencimiento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Tarea.Categoria" class="control-label"></label>
                <input asp-for="Tarea.Categoria" class="form-control" aria-required="true"/>
                <span asp-validation-for="Tarea.Categoria" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tarea.Publicado" class="control-label"></label>
                <input asp-for="Tarea.Publicado" class="form-check-input" />
                <span asp-validation-for="Tarea.Publicado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
